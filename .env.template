# ══════════════════════════════════════════════════════════════
# DigitalTWINS Platform — Environment Configuration Template
# ══════════════════════════════════════════════════════════════
# GENERATED-FILE SOURCE — do not hand-edit the resulting .env. Edit this
# template (for values identical on every deployment) or data/env and
# data/secrets.env (for per-deployment inputs), then re-run gen-env.sh.
#
# Placeholders in dollar-brace form are filled at generation time from
# data/env (non-secret host inputs) and data/secrets.env (secrets).
# NGINX_MODE, SSL and AIRFLOW_UID are derived by gen-env.sh from the
# protocol / host. Everything else is a literal.

# ══════════════════════════════════════════════════════════════
# General
# ══════════════════════════════════════════════════════════════

PROJECT_NAME=digitaltwins-platform

# ══════════════════════════════════════════════════════════════
# IAM Service (Keycloak)
# ══════════════════════════════════════════════════════════════

# --- Bootstrap admin account ---

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD}
#KC_HTTPS_KEY_STORE_PASSWORD=admin

# Whether to verify Keycloak's TLS certificate (used by portal).
# Internal calls use KEYCLOAK_INTERNAL_URL (plain http), so this stays false.
KEYCLOAK_VERIFY_SSL=false

# --- Keycloak public address ---
#
# Keycloak sits BEHIND the gateway at <public-url>/auth. The URL below
# becomes the `iss` claim in every token; FOUR settings must name the
# EXACT same address or you get issuer-mismatch failures:
#   KC_HOSTNAME  KEYCLOAK_PUBLIC_URL  PORTAL_KEYCLOAK_BASE_URL  ORTHANC_KEYCLOAK_URL
# All four are derived below from PLATFORM_PROTOCOL + PLATFORM_DOMAIN so
# they cannot drift. The realm's redirectUris / webOrigins must match too.

KC_HOSTNAME=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/auth
KEYCLOAK_PUBLIC_URL=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/auth

# Context path Keycloak serves from (Keycloak 17+ dropped the historical
# /auth prefix; this puts it back so the gateway routes /auth/* cleanly).
KC_HTTP_RELATIVE_PATH=/auth

# Hostname-strict flags — emitted into .env (not only via the sourced shell)
# so a bare `docker compose up` uses the intended value regardless of
# whether `env` was sourced. false for localhost/http, true for a real
# domain (set in env / env.template).
KC_HOSTNAME_STRICT=${KC_HOSTNAME_STRICT}
KC_HOSTNAME_STRICT_HTTPS=${KC_HOSTNAME_STRICT_HTTPS}

# --- Keycloak internal address ---
# Container-to-container URL for server-side token/userinfo calls. Never
# leaves the Docker network; stays plain HTTP regardless of TLS.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

# ══════════════════════════════════════════════════════════════
# Portal Service
# repo: https://github.com/ABI-CTT-Group/DigitalTWINS-Portal
# ══════════════════════════════════════════════════════════════

# Docker host IP / domain the portal backend advertises. Same value as
# the public domain here (portal is reached through the gateway).
PORTAL_BACKEND_HOST=${PLATFORM_DOMAIN}

# Public scheme the portal bakes into generated URLs (presigned MinIO
# links, CORS origins). Derived from PLATFORM_PROTOCOL (true when https).
SSL=${SSL}

# ══════════════════════════════════════════════════════════════
# Gateway Service (NGINX)
# ══════════════════════════════════════════════════════════════

# Which server config the gateway mounts: "http" or "ssl". Derived from
# PLATFORM_PROTOCOL. (Diverges from SSL only behind an upstream LB that
# terminates TLS: then SSL=true + NGINX_MODE=http — override in the
# generation step if you need that.)
NGINX_MODE=${NGINX_MODE}

# --- Portal via gateway ---

BACKEND_PORT=8000

# Keycloak URL as the portal SPA + backend see it. Must equal KC_HOSTNAME.
PORTAL_KEYCLOAK_BASE_URL=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/auth

# --- DigitalTWINS API via gateway ---

DIGITALTWINS_API_BASE_URL=http://digitaltwins-api
DIGITALTWINS_API_PORT=8000

# ══════════════════════════════════════════════════════════════
# Metadata Service (SEEK / LDH)
# ══════════════════════════════════════════════════════════════
# NOTE: SEEK's MySQL credentials are NOT here. SEEK reads its own
# services/seek/ldh-deployment/docker-compose.env (rendered from
# docker-compose.env.tpl using MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD
# from secrets.env) — a separate install step.

COMPOSE_PROJECT_NAME=digitaltwins-platform

SEEK_PORT=8001
DHO_TERMS=standard

# SEEK/LDH image tag. Pin to a release for production.
LDH_RELEASE=v0.3.2
#LDH_RELEASE=latest

# SEEK's internal NGINX config. SEEK is internal (gateway terminates TLS),
# so it always serves plain HTTP here.
NGINX_CONF=nginx.conf.http

# Keycloak OIDC client secret for SEEK
SEEK_KEYCLOAK_CLIENT_SECRET=${SEEK_KEYCLOAK_CLIENT_SECRET}

# --- Postgres (shared platform database) ---

POSTGRES_USER=admin
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=digitaltwins
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=${PGADMIN_DEFAULT_PASSWORD}

# --- Gen3 (optional, disabled by default) ---

#GEN3_ENABLED=false
#GEN3_ENDPOINT=https://gen3
#GEN3_CRED_FILE=./credentials.json
#GEN3_SSL_CERT=./ca.pem

# ══════════════════════════════════════════════════════════════
# Storage Service (MinIO)
# ══════════════════════════════════════════════════════════════

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
MINIO_SERVER_ACCESS_KEY=minioadmin
MINIO_SERVER_SECRET_KEY=${MINIO_SERVER_SECRET_KEY}

# Public base URL for MinIO Console (browser redirect). Leave empty
# unless the console is exposed through the gateway.
MINIO_BROWSER_REDIRECT_URL=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/minio

# --- iRODS (optional, disabled by default) ---

# ══════════════════════════════════════════════════════════════
# Workflow Service (Airflow)
# ══════════════════════════════════════════════════════════════

# Host user ID for Airflow file ownership (run `id -u`).
AIRFLOW_UID=${AIRFLOW_UID}

AIRFLOW_PORT=8002

# Public base URL for Airflow (must match the gateway /airflow route).
AIRFLOW__API__BASE_URL=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/airflow

# Airflow's own Postgres database (schema within shared Postgres).
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=${AIRFLOW_DB_PASSWORD}
AIRFLOW_DB_NAME=airflow

AIRFLOW__CORE__FERNET_KEY=${AIRFLOW__CORE__FERNET_KEY}

# Keycloak OAuth2 client secret for the 'airflow' OIDC client (used by webserver_config.py for SSO).
AIRFLOW_KEYCLOAK_CLIENT_SECRET=${AIRFLOW_KEYCLOAK_CLIENT_SECRET}
MINIO_KEYCLOAK_CLIENT_SECRET=${MINIO_KEYCLOAK_CLIENT_SECRET}
MINIO_OIDC_CONFIG_URL=${MINIO_OIDC_CONFIG_URL}

# ══════════════════════════════════════════════════════════════
# Notebook Service (JupyterHub)
# ══════════════════════════════════════════════════════════════

# --- JupyterLab (legacy, disabled) ---

#JUPYTERLAB_ENABLED=true
#JUPYTERLAB_URL=http://jupyterlab:8888
#JUPYTERLAB_TOKEN=admin

# --- JupyterHub ---

JUPYTERHUB_PORT=8016

# 32-byte hex key for encrypting auth state (openssl rand -hex 32).
JUPYTERHUB_CRYPT_KEY=${JUPYTERHUB_CRYPT_KEY}

# Public URL for JupyterHub (must match the gateway /jupyter route).
JUPYTERHUB_PUBLIC_URL=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/jupyter

# Keycloak OIDC client credentials for JupyterHub.
JUPYTERHUB_CLIENT_ID=jupyterhub
JUPYTERHUB_CLIENT_SECRET=${JUPYTERHUB_CLIENT_SECRET}

# Group-based access control.
JUPYTERHUB_ALLOWED_GROUPS=admin,researcher
JUPYTERHUB_ADMIN_GROUPS=admin
JUPYTERHUB_ADMIN_USERS=admin

# ══════════════════════════════════════════════════════════════
# PACS Service (Orthanc)
# ══════════════════════════════════════════════════════════════

# --- Orthanc instance 1 ---

ORTHANC_1_HTTP_PORT=8014
ORTHANC_1_DICOM_PORT=8015
ORTHANC_1_AET=dt_pacs_1

# --- Orthanc instance 2 ---

ORTHANC_2_HTTP_PORT=8017
ORTHANC_2_DICOM_PORT=8018
ORTHANC_2_AET=dt_pacs_2

# --- Keycloak integration ---

# Browser-facing Keycloak URL for OE2 login redirect. Must equal KC_HOSTNAME
# (with trailing slash).
ORTHANC_KEYCLOAK_URL=${PLATFORM_PROTOCOL}://${PLATFORM_DOMAIN}/auth/

# Keycloak client secret (must match the realm export JSON).
ORTHANC_KEYCLOAK_CLIENT_SECRET=${ORTHANC_KEYCLOAK_CLIENT_SECRET}

# Internal secret for JWT signing in orthanc-auth-service.
ORTHANC_AUTH_SECRET_KEY=${ORTHANC_AUTH_SECRET_KEY}

# Internal password for the Orthanc <-> auth-service HTTP channel.
ORTHANC_AUTH_SERVICE_PASSWORD=${ORTHANC_AUTH_SERVICE_PASSWORD}

# ══════════════════════════════════════════════════════════════
# EHR Service (HAPI FHIR)
# ══════════════════════════════════════════════════════════════

# No user-configurable variables. HAPI FHIR uses its own
# application.yaml and a dedicated Postgres container.

# ══════════════════════════════════════════════════════════════
# API Service (digitaltwins-api)
# ══════════════════════════════════════════════════════════════

# --- Keycloak (API's own OIDC client) ---

KEYCLOAK_ENABLED=true
KEYCLOAK_BASE_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=digitaltwins
KEYCLOAK_ALGORITHM=RS256
KEYCLOAK_CLIENT_ID=api
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}

# --- SEEK ---

SEEK_ENABLED=true
SEEK_BASE_URL=http://seek:3000/seek

# --- Postgres ---

POSTGRES_ENABLED=true
POSTGRES_HOST=database
POSTGRES_PORT=5432

# --- MinIO ---

MINIO_ENABLED=true
MINIO_ENDPOINT=http://minio:9000

# --- iRODS (optional, disabled by default) ---

#IRODS_ENABLED=false
#IRODS_HOST=irods
#IRODS_PORT=8005
#IRODS_USER=
#IRODS_PASSWORD=
#IRODS_ZONE=
#IRODS_PROJECT_ROOT=

# --- Airflow ---

AIRFLOW_ENABLED=true
AIRFLOW_VERSION=3
AIRFLOW_ENDPOINT=http://airflow-apiserver:8080/airflow
AIRFLOW_USERNAME=admin1
AIRFLOW_PASSWORD=${AIRFLOW_PASSWORD}
# --- Redis ---
REDIS_PASSWORD=${REDIS_PASSWORD}
COMPOSE_FILE=${COMPOSE_FILE}

# The compute queue to use for workflow DAGs. The local environment defaults to "default".
# For remote environments, change this to "remote" to route DAGs to the remote compute node.
AIRFLOW_VAR_COMPUTE_QUEUE=${AIRFLOW_VAR_COMPUTE_QUEUE}
