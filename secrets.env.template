# ------------------------------------------------------------
# secrets.env.template — the secret KEYS the platform needs, with no
# values.
#
# Copy this to `secrets.env`, fill in EVERY value, and keep that file
# out of git (secrets.env is git-ignored). Then run util/gen-env.sh.
#
# Generate strong values with e.g.  openssl rand -hex 32
# ------------------------------------------------------------

# --- Referenced by .env.template (the platform .env) ---
KC_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_SERVER_SECRET_KEY=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_PASSWORD=
AIRFLOW_DB_PASSWORD=
JUPYTERHUB_CLIENT_SECRET=
JUPYTERHUB_CRYPT_KEY=
ORTHANC_AUTH_SERVICE_PASSWORD=
ORTHANC_AUTH_SECRET_KEY=
ORTHANC_KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CLIENT_SECRET=
SEEK_API_TOKEN=

# --- Referenced by SEEK's own docker-compose.env (rendered separately) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- Install-time secrets not referenced by .env.template today ---
# (Airflow internals, Keycloak DB/realm admin, Redis, the observability
#  stack, and SEEK admin — kept so the install process and future route
#  wiring have them available.)
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_REALM_ADMIN_PASSWORD=
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
AIRFLOW_KEYCLOAK_CLIENT_SECRET=
REDIS_PASSWORD=
MIMIR_MINIO_ROOT_USER=
MIMIR_MINIO_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_OAUTH_SECRET=
SEEK_ADMIN_PASSWORD=
SEEK_ADMIN_EMAIL=
SEEK_KEYCLOAK_CLIENT_SECRET=
