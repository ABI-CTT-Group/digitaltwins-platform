cython_debug/

# JetBrains
.idea/
.ollamassist/

/my_workspace/

# Git worktrees
.worktrees/

# Keycloak realm imports - keep the folder, ignore everything else
services/keycloak/import/*
!services/keycloak/import/.gitkeep

# NGINX generated files
services/nginx/snippets/minio-discovery.json

# Airflow config - keep the folder, ignore everything else
services/airflow/config/*
!services/airflow/config/.gitkeep
!services/airflow/config/airflow.cfg
!services/airflow/config/webserver_config.py

# macOS junk
.DS_Store

# Local scratch / realm-export working files (never commit — realm exports can
# contain client secrets and user data)
/tmp/
/*_realm_*.json
