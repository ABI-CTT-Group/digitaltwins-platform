#!/bin/bash
# ---------------------------------------------------------------------------
# LEGACY — brought verbatim from main_buildout:buildout/util. May be stale.
# Exports the `digitaltwins` realm WITH users to a timestamped JSON.
#
# Caveats before relying on this:
#   - It STOPS Keycloak (`docker compose down keycloak`). Do NOT run it against
#     a read-only box; on a read-only source, export against a COPY of the
#     keycloak_data (H2) volume instead.
#   - `--users same_file` is older Keycloak export syntax.
# ---------------------------------------------------------------------------

REALM=digitaltwins

h=$(hostname)
now=$(date +%Y%m%d%H%M)

docker compose down keycloak

docker compose run --name kc-export keycloak export \
    --realm $REALM \
    --file /tmp/my-realm-export.json \
    --users same_file

docker cp kc-export:/tmp/my-realm-export.json ./${h}_${REALM}_realm_${now}.json

docker rm kc-export

docker compose up -d keycloak
