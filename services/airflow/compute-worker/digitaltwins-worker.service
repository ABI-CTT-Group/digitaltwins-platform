# Airflow remote compute worker — runs the compute-node docker compose on boot.
#
# Install on the compute node:
#   sudo cp digitaltwins-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now digitaltwins-worker
#
# Adjust WorkingDirectory to where you put the compute compose + .env.
#
# The docker CLI lands in a different prefix depending on how Docker was
# installed — /usr/bin/docker (apt / connected) vs /usr/local/bin/docker (the
# airgap static-binary install). Rather than hardcode one, we resolve `docker`
# via PATH with `env` and pin PATH to cover both prefixes, so the same unit
# works on either kind of node with no manual edit.
[Unit]
Description=DigitalTWINS Airflow remote compute worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/digitaltwins-compute
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/env docker compose up -d
ExecStop=/usr/bin/env docker compose down

[Install]
WantedBy=multi-user.target
