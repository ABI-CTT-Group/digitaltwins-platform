# Airflow remote compute worker — runs the compute-node docker compose on boot.
#
# Install on the compute node:
#   sudo cp digitaltwins-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now digitaltwins-worker
#
# Adjust WorkingDirectory to where you put the compute compose + .env, and the
# docker path if it differs (apt install = /usr/bin/docker; the airgap static
# install = /usr/local/bin/docker).
[Unit]
Description=DigitalTWINS Airflow remote compute worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/digitaltwins-compute
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
