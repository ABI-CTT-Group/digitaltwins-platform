# ------------------------------------------------------------
# env.template — non-secret, deployment-specific host inputs.
#
# Copy this to `env`, set the values for your deployment, then run
# util/gen-env.sh (which sources it, derives NGINX_MODE/SSL from the
# protocol, and renders .env from .env.template).
#
# The generated `env` file is NOT committed.
# ------------------------------------------------------------

## For a localhost / http deployment
#export PLATFORM_PROTOCOL=http
#export PLATFORM_DOMAIN=localhost
#export KC_HOSTNAME_STRICT=false
#export KC_HOSTNAME_STRICT_HTTPS=false

## For a deployment to a domain over https
export PLATFORM_PROTOCOL=https
export PLATFORM_DOMAIN=your.domain.example
export KC_HOSTNAME_STRICT=true
export KC_HOSTNAME_STRICT_HTTPS=true

REMOTE_COMPUTE=false   # true = also merge services/airflow/remote-compute.override.yml
AIRFLOW_VAR_COMPUTE_QUEUE=default   # 'remote' routes workflow DAGs to the remote compute node

# --- Platform admin identity ---
# ONE admin identity across Keycloak (realm user), SEEK (server admin) and Airflow
# (the FAB user the API logs in as) — they MUST match. Username + email are
# non-secret (here); the password is PLATFORM_ADMIN_PASSWORD in secrets.env.
export PLATFORM_ADMIN_USERNAME=admin1
export PLATFORM_ADMIN_EMAIL=admin@your.domain.example
